{
  "recommendations": [
    // React 官方语言支持（替代 Volar）
    "facebook.react",

    // TypeScript 和 JavaScript 语言支持
    "ms-vscode.vscode-typescript-next",

    // 将 ESLint JavaScript 集成到 VS Code 中
    "dbaeumer.vscode-eslint",

    // Visual Studio Code 的官方 Stylelint 扩展
    "stylelint.vscode-stylelint",

    // 使用 Prettier 的代码格式化程序
    "esbenp.prettier-vscode",

    // 支持 dotenv 文件语法
    "mikestead.dotenv",

    // 源代码的拼写检查器
    "streetsidesoftware.code-spell-checker",

    // Tailwind CSS 的官方 VS Code 插件
    "bradlc.vscode-tailwindcss",

    // Next.js 路由链接自动补全和导航
    "pulkitgangwar.nextjs-snippets",

    // 快速生成 React 组件
    "dsznajder.es7-react-js-snippets",

    // 在 JSX/TSX 中显示 CSS 类名提示
    "anteprimorac.html-end-tag-labels",

    // 在 package.json 中显示版本信息
    "antfu.pnpm-catalog-lens",

    // 自动重命名配对的 HTML/JSX 标签
    "formulahendry.auto-rename-tag",

    // 自动闭合 HTML/JSX 标签
    "formulahendry.auto-close-tag",

    // 可视化 import 路径
    "wix.vscode-import-cost"
  ],
  "unwantedRecommendations": [
    // 移除 Vue 相关扩展
    "Vue.volar",
    "octref.vetur",
    "antfu.iconify",
    "Lokalise.i18n-ally"
  ]
}
